{
  "name": "@leviosa-ai/detail-page-editor",
  "version": "0.11.0",
  "description": "Leviosa detail-page editor shell. Source-only: consumers compile it through Next transpilePackages. Every app coupling (sourcing server, brand store, cache keys, toast) arrives through the DetailPageHost interface, and every URL it fetches comes from configureDetailPageEditor.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leviosa-AI/leviosa-canvas.git",
    "directory": "packages/detail-page-editor"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json",
    "./tokens.css": "./styles/tokens.css",
    "./canvas-bridge.css": "./styles/canvas-bridge.css",
    "./host": "./components/detail-page/detail-page-host-context.tsx",
    "./types": "./types/detail-page-canvas.ts",
    "./i18n": "./i18n/index.ts",
    "./server/stock-photos": "./server/stock-photos.ts",
    "./server/icons": "./server/icons.ts",
    "./server/route-kit": "./server/route-kit.ts",
    "./api-types": "./types/detail-page-api.ts",
    "./commerce-types": "./types/commerce.ts",
    "./components/canvas-store-facade": "./components/detail-page/canvas-store-facade.ts",
    "./components/editor-history": "./components/detail-page/editor-history.ts",
    "./components/hovered-layer": "./components/detail-page/hovered-layer.ts",
    "./components/element-rects": "./components/detail-page/element-rects.ts",
    "./components/detail-page-selection": "./components/detail-page/detail-page-selection.ts",
    "./components/detail-page-thumbnail-bus": "./components/detail-page/detail-page-thumbnail-bus.ts",
    "./components/*": "./components/detail-page/*.tsx",
    "./lib/*": "./lib/detail-page/*.ts",
    "./canvas/*": "./lib/detail-page-canvas/*.ts"
  },
  "files": [
    "index.ts",
    "styles",
    "components",
    "config",
    "i18n",
    "server",
    "lib",
    "types",
    "!**/__tests__"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ag-psd": "^28.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fontkit": "^2.0.4",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^2.0.4",
    "tailwind-merge": "^3.5.0",
    "woff2-encoder": "2.0.0"
  },
  "peerDependencies": {
    "@leviosa-ai/canvas": "0.4.0",
    "@tanstack/react-query": "^5.100.3",
    "konva": "^10.0.0",
    "lucide-react": "^0.563.0 || ^1.0.0",
    "next": "^16.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "react-konva": "^19.0.0"
  }
}
